<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden/sensitive files and directories
    RewriteRule ^(\.env|\.git|\.agents|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml) - [F,L,NC]
    RewriteRule ^(db|storage/logs)/ - [F,L,NC]

    # Redirect all other traffic to public/
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
